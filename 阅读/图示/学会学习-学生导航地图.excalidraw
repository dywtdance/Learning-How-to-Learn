      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "现在最难受或最不清楚的\n具体是什么？\n先分清事实、猜测与状态。",
      "autoResize": true,
      "lineHeight": 1.5
    },
